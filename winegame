#!/usr/bin/env bash
# winegame - per-game Wine prefix manager
# One prefix per game under $PREFIX_ROOT/<name>/, with persistent env vars,
# DLL overrides, per-run logs, winetricks/winecfg integration, and a shell escape hatch.
#
#   winegame new <name> [--win32]          create a new game prefix
#   winegame install <name> <folder|exe>    copy a game folder into the prefix once
#   winegame run <name> [exe] [args...]     run a game (auto-detects exe in game/)
#   winegame setver <name> <ver>            set Windows version (win7|win10|win11|winxp)
#   winegame cfg <name>                    open winecfg for the prefix
#   winegame tricks <name> [pkgs...]       run winetricks (no args = GUI)
#   winegame override <name> [dll=mode]... set DLL overrides (no args = show)
#   winegame env <name> [KEY=VALUE]...     persistent env vars (no args = show)
#   winegame wine <name> [args...]         run arbitrary wine command in prefix
#   winegame shell <name>                  drop into a shell with the prefix env
#   winegame log <name> [-f]               show/tail last run log
#   winegame list                          list all game prefixes
#   winegame remove <name> [-y]            delete a prefix
#   winegame doctor                       check wine/winetricks tooling
#   winegame doctor <name>                 scan a game for missing runtimes, offer fixes
#
# Layout per game:  $PREFIX_ROOT/<name>/prefix   (the WINEPREFIX)
#                   $PREFIX_ROOT/<name>/game     (drop your game files here)
#                   $PREFIX_ROOT/<name>/env      (persistent env, sourced)
#                   $PREFIX_ROOT/<name>/logs/    (run logs)
#
# Override PREFIX_ROOT with $WINE_GAMES_DIR if you want it elsewhere.

set -euo pipefail

VERSION="1.2.0"
PREFIX_ROOT="${WINE_GAMES_DIR:-$HOME/.games}"
COMMANDS=(new install run cfg setver tricks override env wine shell log list remove doctor)

# --- colors (off when piped or NO_COLOR) -------------------------------------
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
  C_G=$'\e[32m'; C_Y=$'\e[33m'; C_R=$'\e[31m'; C_B=$'\e[1m'; C_D=$'\e[2m'; C_X=$'\e[0m'
else
  C_G=; C_Y=; C_R=; C_B=; C_D=; C_X=
fi

die()  { echo "${C_R}error:${C_X} $*" >&2; exit 1; }
msg()  { echo "${C_G}==>${C_X} $*"; }
warn() { echo "${C_Y}warn:${C_X} $*" >&2; }

game_dir()  { echo "$PREFIX_ROOT/$1"; }
prefix_dir(){ echo "$PREFIX_ROOT/$1/prefix"; }
env_file()  { echo "$PREFIX_ROOT/$1/env"; }
log_dir()   { echo "$PREFIX_ROOT/$1/logs"; }

valid_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] && [[ "$1" != "." ]] && [[ "$1" != ".." ]]; }

require_game() {
  [[ -n "${1:-}" ]] || die "missing game name"
  [[ -d "$(prefix_dir "$1")" ]] || die "no such game '$1' (create it: winegame new $1)"
}

# source the env file — values are written by set_env with proper quoting,
# same trust model as your own shell rc.
load_env() {
  local f; f="$(env_file "$1")"
  [[ -f "$f" ]] && source "$f"
}

# read one key from an env file (subshell so nothing leaks)
get_env_val() {
  local f; f="$(env_file "$1")"
  [[ -f "$f" ]] || return 0
  ( source "$f"; printf '%s' "${!2:-}" )
}

# upsert KEY=VALUE into an env file (single-quote escaped)
set_env() {
  local file; file="$(env_file "$1")"; local key=$2 val=$3
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "bad env key '$key'"
  local tmp; tmp="$(mktemp)"
  local found=0
  if [[ -f "$file" ]]; then
    while IFS= read -r line; do
      if [[ "$line" == "$key="* ]]; then
        printf "%s='%s'\n" "$key" "${val//\'/\'\\\'\'}" >> "$tmp"; found=1
      else
        printf '%s\n' "$line" >> "$tmp"
      fi
    done < "$file"
  fi
  [[ $found -eq 1 ]] || printf "%s='%s'\n" "$key" "${val//\'/\'\\\'\'}" >> "$tmp"
  mv "$tmp" "$file"
}

del_env() { # remove a key entirely
  local file; file="$(env_file "$1")"; local key=$2
  [[ -f "$file" ]] || return 0
  local tmp; tmp="$(mktemp)"
  while IFS= read -r line; do
    [[ "$line" == "$key="* ]] || printf '%s\n' "$line" >> "$tmp"
  done < "$file"
  mv "$tmp" "$file"
}

require_wine() {
  command -v wine >/dev/null || die "wine not found — install it: sudo apt install wine winetricks (or your distro's package)"
}

# --- commands ----------------------------------------------------------------

cmd_new() {
  local name="${1:-}" arch=win64
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --win32) arch=win32; shift ;;
      --win64) arch=win64; shift ;;
      *) die "unknown option '$1' (try --win32/--win64)" ;;
    esac
  done
  [[ -n "$name" ]] || die "usage: winegame new <name> [--win32]"
  valid_name "$name" || die "invalid name '$name' (alnum, dot, dash, underscore only)"
  [[ -d "$(prefix_dir "$name")" ]] && die "game '$name' already exists"
  mkdir -p "$(prefix_dir "$name")" "$(game_dir "$name")/game" "$(log_dir "$name")"
  echo "WINEARCH=$arch" > "$(env_file "$name")"
  # movie-decode fix: carry the right VA-API driver into every new prefix unless
  # it's already global (covers winegstreamer video on Intel Skylake+ / AMD)
  local vd; vd="$(vaapi_driver)"
  if [[ -n "$vd" ]] && [[ -z "${LIBVA_DRIVER_NAME:-}" ]] && ! grep -qs "^LIBVA_DRIVER_NAME=$vd" /etc/environment 2>/dev/null; then
    set_env "$name" LIBVA_DRIVER_NAME "$vd"
  fi
  msg "created $(game_dir "$name") (arch=$arch)"
  if command -v wineboot >/dev/null; then
    msg "initializing prefix (first wineboot is slow, that's normal)..."
    set +e
    load_env "$name"
    export WINEPREFIX="$(prefix_dir "$name")"
    wineboot -i >/dev/null 2>&1
    local st=$?
    set -e
    [[ $st -eq 0 ]] || warn "wineboot exited $st — prefix may be incomplete; try 'winegame cfg $name'"
  else
    warn "wine not installed — prefix dir created but not initialized (run 'winegame doctor')"
  fi
  msg "put game files in $(game_dir "$name")/game/ then: winegame run $name"
}

cmd_run() {
  local name="" gamemode=0 no_copy=0 verbose=0 exe=""
  local -a args=()
  # flags may come before or after the game name
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -g|--gamemode) gamemode=1; shift ;;
      --no-copy) no_copy=1; shift ;;
      -v|--verbose) verbose=1; shift ;;
      --) shift; break ;;
      -*) die "unknown option '$1' (run flags: -g/--gamemode, --no-copy, -v/--verbose)" ;;
      *)
        if [[ -z "$name" ]]; then name=$1; shift
        else break; fi
        ;;
    esac
  done
  require_game "$name"
  require_wine
  if [[ $# -gt 0 ]]; then
    if [[ "$1" == *.exe ]] || [[ -f "$1" ]] || [[ -f "$(game_dir "$name")/game/$1" ]]; then
      exe=$1; shift
    fi
  fi
  args=("$@")

  if [[ -z "$exe" ]]; then
    local dir; dir="$(game_dir "$name")/game"
    local found=()
    while IFS= read -r -d '' f; do found+=("$f"); done < <(find "$dir" -maxdepth 2 -iname '*.exe' -print0 2>/dev/null || true)
    case ${#found[@]} in
      0) die "no .exe in $dir — pass one: winegame run $name /path/to/game.exe" ;;
      1) exe=${found[0]} ;;
      *)
        echo "multiple executables found:"
        for i in "${!found[@]}"; do printf '%2d) %s\n' "$((i+1))" "${found[$i]#$dir/}"; done
        read -rp "pick [1-${#found[@]}]: " choice
        [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#found[@]} )) || die "bad choice"
        exe=${found[$((choice-1))]}
        ;;
    esac
  else
    # resolve relative exe paths against game/, game dir, then cwd
    if [[ "$exe" != /* ]]; then
      if [[ -f "$(game_dir "$name")/game/$exe" ]]; then exe="$(game_dir "$name")/game/$exe"
      elif [[ -f "$(game_dir "$name")/$exe" ]]; then exe="$(game_dir "$name")/$exe"
      elif [[ -f "$PWD/$exe" ]]; then exe="$PWD/$exe"
      fi
    fi
    [[ -f "$exe" ]] || die "no such exe: $exe"
  fi

  # external path → offer to copy it into the prefix once, then it's just 'winegame run <name>'
  if [[ "$exe" != "$(game_dir "$name")/game/"* ]]; then
    local src_dir; src_dir="$(dirname "$exe")"
    if [[ $no_copy -eq 0 ]]; then
      local ans=n
      if [[ -t 0 ]]; then
        read -rp "copy '$src_dir' into $(game_dir "$name")/game/? [y/N] " ans
      fi
      if [[ "$ans" == y || "$ans" == Y ]]; then
        cmd_install "$name" "$src_dir"
        exe="$(game_dir "$name")/game/$(basename "$src_dir")/$(basename "$exe")"
      fi
    fi
  fi

  load_env "$name"
  export WINEPREFIX="$(prefix_dir "$name")"
  [[ $verbose -eq 1 ]] || export WINEDEBUG="${WINEDEBUG:--all}"
  local -a runner=()
  if [[ $gamemode -eq 1 ]]; then
    if command -v gamemoderun >/dev/null 2>&1; then
      runner=(gamemoderun)
    else
      warn "gamemode not installed (apt install gamemode) — running without it"
    fi
  fi
  mkdir -p "$(log_dir "$name")"
  local log; log="$(log_dir "$name")/$(date +%Y%m%d-%H%M%S).log"
  msg "running ${exe#$PREFIX_ROOT/} ${args[*]:-}"
  msg "log: $log"
  cd "$(dirname "$exe")"
  set +e
  "${runner[@]}" wine "./$(basename "$exe")" "${args[@]}" 2>&1 | tee "$log"
  local st=${PIPESTATUS[0]}
  set -e
  if [[ $st -ne 0 ]]; then
    warn "wine exited with $st (last run log: $log)"
    return $st
  fi
}

cmd_install() {
  local name="${1:-}" src="${2:-}"
  [[ -n "$name" && -n "$src" ]] || die "usage: winegame install <name> <game-folder-or-exe>"
  require_game "$name"
  [[ -e "$src" ]] || die "no such path: $src"
  local src_dir="$src"
  [[ -d "$src" ]] || src_dir="$(dirname "$src")"
  src_dir="$(cd "$src_dir" && pwd)"
  local target; target="$(game_dir "$name")/game/$(basename "$src_dir")"
  [[ -e "$target" ]] && die "already installed at $target"
  mkdir -p "$(dirname "$target")"
  msg "copying $src_dir → $target ..."
  if command -v rsync >/dev/null 2>&1; then
    rsync -a --info=progress2 "$src_dir/" "$target/"
  else
    cp -r "$src_dir" "$target"
  fi
  msg "installed. now just: winegame run $name"
}

cmd_setver() {
  local name="${1:-}" ver="${2:-}"
  require_game "$name"
  require_wine
  case "$ver" in
    win7|win10|win11|winxp) ;;
    *) die "usage: winegame setver <name> <win7|win10|win11|winxp>" ;;
  esac
  load_env "$name"
  export WINEPREFIX="$(prefix_dir "$name")"
  winecfg -v "$ver" >/dev/null 2>&1 || die "winecfg -v $ver failed"
  msg "$name prefix now reports $ver"
}

cmd_cfg() {
  require_game "${1:-}"
  require_wine
  load_env "$1"
  export WINEPREFIX="$(prefix_dir "$1")"
  exec winecfg "${@:2}"
}

cmd_tricks() {
  local name="${1:-}"; shift || true
  require_game "$name"
  command -v winetricks >/dev/null || die "winetricks not found — install it: sudo apt install winetricks"
  load_env "$name"
  export WINEPREFIX="$(prefix_dir "$name")"
  if [[ $# -eq 0 ]]; then
    msg "no packages given — opening winetricks GUI"
    exec winetricks --gui
  fi
  msg "winetricks $*"
  exec winetricks "$@"
}

cmd_override() {
  local name="${1:-}"; shift || true
  require_game "$name"
  if [[ $# -eq 0 ]]; then
    local cur; cur="$(get_env_val "$name" WINEDLLOVERRIDES)"
    if [[ -n "$cur" ]]; then msg "current overrides: $cur"
    else msg "no overrides set (e.g.: winegame override $name dinput8=n,b)"; fi
    return 0
  fi
  local cur; cur="$(get_env_val "$name" WINEDLLOVERRIDES)"
  IFS=';' read -ra existing <<< "$cur"
  local -a keep=()
  for e in "${existing[@]}"; do
    [[ -z "$e" ]] && continue
    local dll="${e%%=*}"
    local dup=0
    for n in "$@"; do [[ "${n%%=*}" == "$dll" ]] && dup=1; done
    [[ $dup -eq 0 ]] && keep+=("$e")
  done
  local -a merged=("${keep[@]}" "$@")
  local joined; joined="$(IFS=';'; echo "${merged[*]}")"
  set_env "$name" WINEDLLOVERRIDES "$joined"
  msg "overrides: $joined"
}

cmd_env() {
  local name="${1:-}"; shift || true
  require_game "$name"
  if [[ $# -eq 0 ]]; then
    local f; f="$(env_file "$name")"
    [[ -f "$f" ]] || { msg "no env set"; return 0; }
    msg "env for $name:"
    while IFS= read -r line; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      echo "  $line"
    done < "$f"
    return 0
  fi
  for kv in "$@"; do
    local key="${kv%%=*}" val
    [[ "$kv" == *=* ]] || die "expected KEY=VALUE, got '$kv'"
    val="${kv#*=}"
    if [[ -z "$val" ]]; then
      del_env "$name" "$key"
      msg "unset $key"
    else
      set_env "$name" "$key" "$val"
      msg "set $key='$val'"
    fi
  done
}

cmd_wine() {
  local name="${1:-}"; shift || true
  require_game "$name"
  require_wine
  load_env "$name"
  export WINEPREFIX="$(prefix_dir "$name")"
  exec wine "$@"
}

cmd_shell() {
  require_game "${1:-}"
  load_env "$1"
  export WINEPREFIX="$(prefix_dir "$1")"
  [[ -d "$(game_dir "$1")/game" ]] && cd "$(game_dir "$1")/game"
  msg "prefix shell for $1 (WINEPREFIX=$WINEPREFIX) — exit to leave"
  exec "${SHELL:-bash}"
}

cmd_log() {
  local name="${1:-}"; shift || true
  require_game "$name"
  local log; log="$(ls -t "$(log_dir "$name")"/*.log 2>/dev/null | head -1 || true)"
  [[ -n "$log" ]] || die "no logs yet for $name"
  if [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]]; then
    exec tail -f "$log"
  fi
  exec tail -n 100 "$log"
}

cmd_list() {
  [[ -d "$PREFIX_ROOT" ]] || { msg "no games yet ($PREFIX_ROOT) — winegame new <name>"; return 0; }
  local any=0
  for d in "$PREFIX_ROOT"/*/; do
    [[ -d "$d/prefix" ]] || continue
    any=1
    local name; name="$(basename "$d")"
    local arch; arch="$(get_env_val "$name" WINEARCH)"
    local size; size="$(du -sh "$d/prefix" 2>/dev/null | cut -f1)"
    printf '  %-24s %-7s %s\n' "$name" "${arch:-win64}" "${size:-?}"
  done
  [[ $any -eq 1 ]] || msg "no games yet ($PREFIX_ROOT) — winegame new <name>"
}

cmd_remove() {
  local name="${1:-}"; shift || true
  require_game "$name"
  local force=0
  [[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && force=1
  if [[ $force -eq 0 ]]; then
    read -rp "delete '$name' and its whole prefix? [y/N] " ans
    [[ "$ans" == y || "$ans" == Y ]] || { msg "aborted"; return 0; }
  fi
  rm -rf "$(game_dir "$name")"
  msg "removed $name"
}

cmd_doctor() {
  msg "winegame $VERSION — prefix root: $PREFIX_ROOT"
  local ok=1
  for t in wine wineboot winecfg winepath winetricks; do
    if command -v "$t" >/dev/null; then
      local v; v="$("$t" --version 2>/dev/null | head -1 || true)"
      msg "  $t: ${v:-found}"
    else
      warn "  $t: NOT FOUND"; ok=0
    fi
  done
  if command -v gamemoderun >/dev/null 2>&1; then msg "  gamemode: found"
  else warn "  gamemode: NOT FOUND (optional — apt install gamemode)"; fi
  if command -v rsync >/dev/null 2>&1; then msg "  rsync: found (fast installs)"
  else warn "  rsync: NOT FOUND (installs fall back to cp)"; fi
  local n=0
  [[ -d "$PREFIX_ROOT" ]] && n="$(cmd_list | grep -c . || true)"
  msg "  games: $n"
  local state; state="$(wine_build_state)"
  case "$state" in
    bad)     warn "  wine build: Debian repack — known winegstreamer movie deadlock (VNs hang on a blank screen)"; msg "  → run: winegame doctor fix" ;;
    missing) warn "  wine: NOT INSTALLED — run: winegame doctor fix" ;;
    good)    msg "  wine build: not the Debian repack — OK" ;;
  esac
  local gpu; gpu="$(gpu_vendor)"
  msg "  GPU: $gpu"
  local vd; vd="$(vaapi_driver)"
  if [[ -n "$vd" ]]; then
    if [[ -n "${LIBVA_DRIVER_NAME:-}" ]] || grep -qs "^LIBVA_DRIVER_NAME=$vd" /etc/environment 2>/dev/null; then
      msg "  VA-API driver: $vd (hardware video decode OK)"
    else
      warn "  VA-API driver: unset → wrong fallback breaks video decode ($gpu)"
      msg "  → run: winegame doctor fix"
    fi
  else
    warn "  GPU ($gpu): no VA-API driver — videos need software decode (gstreamer1.0-libav:i386)"
    msg "  → run: winegame doctor fix"
  fi
  [[ $ok -eq 1 ]] && msg "tooling looks good." || warn "install missing tools: sudo apt install wine winetricks"
}

# wine build state: "bad" = Debian repack (broken winegstreamer movie path),
# "good" = anything else (WineHQ/Staging/upstream), "missing" = no wine.
wine_build_state() {
  local v; v="$(wine --version 2>/dev/null | head -1 || true)"
  [[ -z "$v" ]] && { echo missing; return; }
  case "$v" in
    *repack*|*" (Debian"*) echo bad ;;
    *) echo good ;;
  esac
}

# GPU vendor for VA-API driver selection (intel|amd|nvidia|unknown)
gpu_vendor() {
  command -v lspci >/dev/null 2>&1 || { echo unknown; return; }
  local id; id="$(lspci 2>/dev/null | grep -iE 'vga|3d controller|display controller' | head -1)"
  case "$id" in
    *Intel*) echo intel ;;
    *AMD*|*ATI*|*Radeon*) echo amd ;;
    *NVIDIA*) echo nvidia ;;
    *) echo unknown ;;
  esac
}

# right LIBVA_DRIVER_NAME for this GPU ("" = no VA-API driver available)
vaapi_driver() {
  case "$(gpu_vendor)" in
    intel) echo iHD ;;
    amd) echo radeonsi ;;
    *) echo "" ;;
  esac
}

# doctor fix: swap the broken Debian wine for WineHQ staging and point VA-API
# at the iHD driver. Fixes the winegstreamer movie deadlock + Skylake video
# decode in one pass (tested: wine-11.15 staging + LIBVA_DRIVER_NAME=iHD).
cmd_doctor_fix() {
  local only="${1:-}"
  local state; state="$(wine_build_state)"
  case "$state" in
    bad)
      msg "your wine is the Debian build with the broken winegstreamer — installing WineHQ staging instead"
      msg "this needs sudo and replaces the Debian wine package (prefixes auto-upgrade on next run)"
      local ans=n
      if [[ -t 0 ]]; then read -rp "continue? [y/N] " ans; fi
      [[ "$ans" == y || "$ans" == Y ]] || die "aborted"
      local codename; codename="$(. /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-trixie}")"
      sudo mkdir -p /etc/apt/keyrings
      sudo wget -qO /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key
      sudo tee "/etc/apt/sources.list.d/winehq-${codename}.sources" >/dev/null <<EOF
Types: deb
URIs: https://dl.winehq.org/wine-builds/debian/
Suites: ${codename}
Components: main
Architectures: amd64 i386
Signed-By: /etc/apt/keyrings/winehq-archive.key
EOF
      sudo apt update
      local vpkgs=""
      case "$(gpu_vendor)" in
        intel) vpkgs="intel-media-va-driver:i386" ;;
        amd)   vpkgs="mesa-va-drivers:i386" ;;
      esac
      sudo apt install --install-recommends winehq-staging gstreamer1.0-libav:i386 gstreamer1.0-plugins-bad:i386 gstreamer1.0-vaapi:i386 $vpkgs
      msg "wine is now: $(wine --version 2>/dev/null | head -1)"
      ;;
    missing)
      warn "wine not installed — add the WineHQ repo, then: sudo apt install winehq-staging"
      ;;
    good)
      msg "wine build already fine — skipping install"
      ;;
  esac

  # VA-API driver: global (covers ~/.wine and everything else) + per-game env
  local vd; vd="$(vaapi_driver)"
  if [[ -n "$vd" ]]; then
    if grep -qs "^LIBVA_DRIVER_NAME=$vd" /etc/environment 2>/dev/null; then
      msg "LIBVA_DRIVER_NAME=$vd already set in /etc/environment"
    else
      msg "adding LIBVA_DRIVER_NAME=$vd to /etc/environment (global)"
      sudo sh -c "grep -qs '^LIBVA_DRIVER_NAME=$vd' /etc/environment || echo 'LIBVA_DRIVER_NAME=$vd' >> /etc/environment"
    fi
    local name
    for name in $(cmd_list_names); do
      [[ -n "$only" && "$name" != "$only" ]] && continue
      set_env "$name" LIBVA_DRIVER_NAME "$vd"
      msg "  env[$name] LIBVA_DRIVER_NAME=$vd"
    done
  else
    warn "no VA-API driver for this GPU — skipping driver env (software decode via gstreamer1.0-libav:i386)"
  fi
  msg "done — run 'winegame doctor' to verify"
}

# DLLs wine ships as builtins / standard system libs — not worth flagging
WHITELIST_DLLS="advapi32 comctl32 comdlg32 crypt32 d3d10 d3d10_1 d3d10core d3d10level9 d3d11 d3d12 d3d8 d3d9 ddraw dnsapi dsound dwmapi gdi32 gdiplus glu32 imm32 iphlpapi kernel32 mpr msimg32 msvcrt msvcrt20 msvcrt40 netapi32 ntdll odbc32 ole32 oleaut32 opengl32 powrprof psapi rasapi32 rpcrt4 secur32 sensapi setupapi shell32 shlwapi user32 userenv uxtheme version wined3d winhttp wininet winmm winspool wintrust ws2_32 wsock32 wtsapi32"

# map a missing DLL to the winetricks verb that provides it (lowercased input)
verb_for_dll() {
  case "$(tr 'A-Z' 'a-z' <<< "$1")" in
    msvcp140.dll|vcruntime140.dll|vcruntime140_1.dll|concrt140.dll) echo vcrun2022 ;;
    msvcp120.dll|msvcr120.dll) echo vcrun2013 ;;
    msvcp110.dll|msvcr110.dll) echo vcrun2012 ;;
    msvcp100.dll|msvcr100.dll) echo vcrun2010 ;;
    msvcp90.dll|msvcr90.dll) echo vcrun2008 ;;
    msvcp80.dll|msvcr80.dll) echo vcrun2005 ;;
    msvcp71.dll|msvcr71.dll) echo vcrun2003 ;;
    d3dx9_*.dll) echo d3dx9 ;;
    d3dx10*.dll) echo d3dx10 ;;
    d3dx11_*.dll) echo d3dx11_43 ;;
    d3dcompiler_43.dll) echo d3dcompiler_43 ;;
    d3dcompiler_46.dll) echo d3dcompiler_46 ;;
    d3dcompiler_47.dll) echo d3dcompiler_47 ;;
    xinput1_*.dll|xinput9_1_0.dll) echo xinput ;;
    xactengine*.dll|xaudio2_*.dll|x3daudio*.dll) echo xact ;;
    physxloader.dll|physx3*.dll) echo physx ;;
    openal32.dll|openal.dll) echo openal ;;
    mscoree.dll|coreclr.dll) echo dotnet48 ;;
    mfplat.dll|mf.dll|mfreadwrite.dll|mfplay.dll|mfsvr.dll) echo mf ;;
    *) return 1 ;;
  esac
}

# per-game runtime doctor: scan exe imports, flag missing DLLs, offer winetricks fixes
# second arg --report = scan only, no prompts (used for the post-install rescan)
game_doctor() {
  local name="${1:-}" report=0
  [[ "${2:-}" == "--report" ]] && report=1
  require_game "$name"
  local state; state="$(wine_build_state)"
  case "$state" in
    bad) warn "  wine build: Debian repack — movie deadlock risk (blank screen)"; msg "  → run: winegame doctor fix" ;;
  esac
  local vd; vd="$(vaapi_driver)"
  if [[ -n "$vd" ]] && ! { [[ -n "${LIBVA_DRIVER_NAME:-}" ]] || grep -qs "^LIBVA_DRIVER_NAME=$vd" "$(env_file "$name")" 2>/dev/null || grep -qs "^LIBVA_DRIVER_NAME=$vd" /etc/environment 2>/dev/null; }; then
    warn "  LIBVA_DRIVER_NAME: not $vd — video decode may fail"
    msg "  → run: winegame doctor fix $name"
  fi
  if grep -qs '^GST_PLUGIN_FEATURE_RANK=' "$(env_file "$name")" 2>/dev/null; then
    warn "  GST_PLUGIN_FEATURE_RANK set (disables VA-API) — with winehq+iHD you can drop it:"
    msg "    winegame env $name GST_PLUGIN_FEATURE_RANK="
  fi
  local gdir; gdir="$(game_dir "$name")/game"
  local -a exes=()
  while IFS= read -r -d '' f; do exes+=("$f"); done < <(find "$gdir" -maxdepth 2 -iname '*.exe' -print0 2>/dev/null || true)
  if [[ ${#exes[@]} -eq 0 ]]; then
    msg "no .exe found in $gdir — install the game first (winegame install $name <folder>)"
    return 0
  fi
  if ! command -v objdump >/dev/null 2>&1; then
    warn "objdump (binutils) not found — can't scan imports (sudo apt install binutils)"
    return 1
  fi
  msg "scanning ${#exes[@]} executable(s) for missing runtimes..."

  # case-insensitive presence sets: game dir + prefix system32/syswow64
  local -A present=()
  local f d
  while IFS= read -r -d '' f; do present["$(basename "$f" | tr 'A-Z' 'a-z')"]=1; done < <(find "$gdir" -maxdepth 2 -type f -print0 2>/dev/null)
  for d in "$(prefix_dir "$name")/drive_c/windows/system32" "$(prefix_dir "$name")/drive_c/windows/syswow64"; do
    [[ -d "$d" ]] || continue
    while IFS= read -r -d '' f; do present["$(basename "$f" | tr 'A-Z' 'a-z')"]=1; done < <(find "$d" -maxdepth 1 -type f -print0 2>/dev/null)
  done

  local -A missing=() verbs=()
  local e dll verb
  for e in "${exes[@]}"; do
    while read -r dll; do
      [[ -n "$dll" ]] || continue
      dll="$(tr 'A-Z' 'a-z' <<< "$dll")"
      [[ -n "${missing[$dll]:-}" || -n "${present[$dll]:-}" ]] && continue
      case "$dll" in
        api-ms-*|ext-ms-*) continue ;;
      esac
      grep -qw "$dll" <<< "$WHITELIST_DLLS" && continue
      missing[$dll]=1
      if verb="$(verb_for_dll "$dll")"; then
        [[ -n "${verbs[$verb]:-}" ]] || verbs[$verb]=$dll
      fi
    done < <(objdump -p "$e" 2>/dev/null | grep -i 'DLL Name:' | awk '{print $3}')
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    msg "no missing DLLs — every import resolves or ships with the game"
    return 0
  fi

  msg "${#missing[@]} missing DLL(s):"
  printf '%s\n' "${!missing[@]}" | sort | sed 's/^/  /'

  if ! command -v winetricks >/dev/null 2>&1; then
    warn "winetricks not installed — can't auto-fix (sudo apt install winetricks)"
    return 1
  fi

  local -A valid=()
  local v
  while read -r v; do [[ -n "$v" ]] && valid[$v]=1; done < <(winetricks list-all 2>/dev/null | awk '{print $1}')

  local -a installable=()
  for v in "${!verbs[@]}"; do
    if [[ -n "${valid[$v]:-}" ]]; then installable+=("$v")
    else warn "winetricks verb '$v' unavailable in this version — skipping"; fi
  done

  if [[ ${#installable[@]} -eq 0 ]]; then
    msg "no known winetricks fix for the missing DLLs above (they may ship with the game/crack)"
    return 1
  fi

  mapfile -t installable < <(printf '%s\n' "${installable[@]}" | sort)
  msg "fixable via winetricks:"
  local vv
  for vv in "${installable[@]}"; do printf '  %-14s (needs %s)\n' "$vv" "${verbs[$vv]}"; done

  if [[ $report -eq 1 ]]; then return 1; fi
  local ans=n
  if [[ -t 0 ]]; then
    read -rp "install ${#installable[@]} runtime(s) now? [y/N] " ans
  fi
  if [[ "$ans" != y && "$ans" != Y ]]; then
    msg "skipped — run again later: winegame doctor $name"
    return 1
  fi

  load_env "$name"
  export WINEPREFIX="$(prefix_dir "$name")"
  local done_any=0
  for vv in "${installable[@]}"; do
    msg "installing $vv ..."
    if winetricks -q "$vv" >/dev/null 2>&1; then msg "  $vv done"; done_any=1
    else warn "  $vv failed"; fi
  done
  if [[ $done_any -eq 1 ]]; then
    msg "re-scanning..."
    game_doctor "$name" --report
  fi
}

cmd_list_names() { # internal: bare game names for completion
  [[ -d "$PREFIX_ROOT" ]] || return 0
  for d in "$PREFIX_ROOT"/*/; do
    [[ -d "$d/prefix" ]] && basename "$d"
  done
}

cmd_install_completion() {
  local rc
  case "${SHELL##*/}" in
    zsh)  rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    *) die "unsupported shell '${SHELL##*/}' — add completion manually" ;;
  esac
  local marker="# winegame completion (managed block — safe to delete)"
  if grep -qF "$marker" "$rc" 2>/dev/null; then warn "completion already installed in $rc"; return 0; fi
  {
    echo ""
    echo "$marker"
    echo 'if command -v winegame >/dev/null 2>&1; then'
    if [[ "${SHELL##*/}" == zsh ]]; then
      cat <<'EOF'
_winegame() {
  local -a cmds games
  cmds=(${(f)"$(winegame --commands 2>/dev/null)"})
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
  elif (( CURRENT == 3 )); then
    games=(${(f)"$(winegame --list-names 2>/dev/null)"})
    _describe 'game' games
  fi
}
compdef _winegame winegame
EOF
    else
      cat <<'EOF'
_winegame_complete() {
  local cur="${COMP_WORDS[COMP_CUR]}"
  if [[ ${COMP_CWORD} -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$(winegame --commands)" -- "$cur") )
  else
    COMPREPLY=( $(compgen -W "$(winegame --list-names)" -- "$cur") )
  fi
}
complete -F _winegame_complete winegame
EOF
    fi
    echo 'fi'
  } >> "$rc"
  msg "completion installed in $rc — restart shell or 'source $rc' to activate"
}

usage() {
  cat <<EOF
${C_B}winegame $VERSION${C_X} — per-game Wine prefix manager

${C_B}usage:${C_X} winegame <command> [args...]

${C_B}commands:${C_X}
  new <name> [--win32]        create a prefix (--win32 for 32-bit only games)
  install <name> <folder|exe> copy a game folder into the prefix once
  run <name> [exe] [args...]  run a game; exe auto-detected in <name>/game/
                              flags: -g/--gamemode, --no-copy, -v/--verbose
  cfg <name>                  open winecfg (DLL overrides, display, etc.)
  setver <name> <ver>         set Windows version (win7|win10|win11|winxp)
  tricks <name> [pkgs...]     winetricks; no packages = GUI (e.g. vcrun2019 -q)
  override <name> [dll=mode]  set DLL overrides (dinput8=n,b); no args = show
  env <name> [KEY=VALUE]...   persistent env for the prefix; no args = show
  wine <name> [args...]       raw wine passthrough in the prefix
  shell <name>                shell with prefix env loaded (escape hatch)
  log <name> [-f]             show/tail latest run log
  list                        list prefixes
  remove <name> [-y]          delete a prefix (asks unless -y)
  doctor                      check wine/winetricks tooling
  doctor fix [name]           install WineHQ wine + right VA-API driver (fixes movie deadlock)
  doctor <name>               scan a game for missing runtimes, offer winetricks fixes

${C_B}layout:${C_X}  $PREFIX_ROOT/<name>/{prefix,game,env,logs}
${C_B}config:${C_X}  set WINE_GAMES_DIR to relocate prefixes
${C_B}extra:${C_X}   winegame --install-completion | --commands | --list-names
EOF
}

# --- dispatch ----------------------------------------------------------------
main() {
  case "${1:-}" in
    ""|-h|--help|help) usage ;;
    --version|-V) echo "winegame $VERSION" ;;
    --commands) printf '%s\n' "${COMMANDS[@]}" ;;
    --list-names) cmd_list_names ;;
    --install-completion) cmd_install_completion ;;
    doctor)
      case "${2:-}" in
        fix) cmd_doctor_fix "${3:-}" ;;
        *) if [[ -n "${2:-}" ]]; then game_doctor "$2"; else cmd_doctor; fi ;;
      esac
      ;;
    new|install|run|cfg|setver|tricks|list|remove|override|env|shell|log|wine) "cmd_$1" "${@:2}" ;;
    *) die "unknown command '$1' (see: winegame --help)" ;;
  esac
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
